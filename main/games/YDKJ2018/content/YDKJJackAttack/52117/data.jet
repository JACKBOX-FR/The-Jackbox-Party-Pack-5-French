    },
    {
      "t": "S",
      "v": "Coca Cola ",
      "n": "Root2Text"
    },
    {
      "t": "S",
      "v": "« Gifle-les bien, Harry » ",
      "n": "Choice5_4Text"
    },
    {
      "t": "S",
      "v": "\"C'est du Coca !\" ",
      "n": "Choice2_3Text"
    },
    {
      "t": "S",
      "v": "\"C'est un peu chic\" ",
      "n": "Choice4_2Text"
    },
    {
      "t": "S",
      "v": "Pékin « Un monde, un rêve » ",
      "n": "Choice6_1Text"
    },
    {
      "t": "S",
      "v": "\"Pourquoi s'amuser avec quelqu'un d'autre ?\" ",
      "n": "Choice3_5Text"
    },
    {
      "t": "S",
      "v": "« Pour ce prix-là, je prends cinquante burgers ! ",
