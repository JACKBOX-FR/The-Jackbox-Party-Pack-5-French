    {
      "t": "S",
      "v": "De quelle doctrine juridique du monde réel s’agit-il ? ",
      "n": "QuestionText2"
    },
    {
      "t": "S",
      "v": "Before",
      "n": "BumperPlacement"
    },
    {
      "t": "S",
      "v": "Suppose in the courtroom finale of <i>Once Upon a Time</i>, Excalibur becomes inadmissible as evidence in Cinderella’s case because it was discovered through an illegally obtained magic mirror.",
      "n": "QuestionText1"
    },
    {
      "s": "S'il vous plaît, approchez-vous de la fille ",
      "t": "A",
      "v": "723073_1",
      "n": "CategoryAudio"
    },
    {
      "s": "Suivez simplement le fil d’Ariane pour obtenir une meilleure réponse. ",
      "t": "A",
      "v": "723085_3",
      "n": "WrongAnswerAudio3"
    },
    {
      "s": "",
      "t": "A",
      "n": "IntroAudio"
    },
    {
      "s": "",
      "t": "A",
      "v": "723076_1",
      "n": "ChoicesAudio"
    },
    {
      "s": "Tout est bien qui finit bien... sauf ça. ",
      "t": "A",
      "v": "723083_1",
      "n": "WrongAnswerAudio2"
    },
    {
      "s": "Fermez les yeux et faites un vœu... car c'est votre seule chance de gagner. ",
      "t": "A",
      "v": "723081_1",
      "n": "WrongAnswerAudio1"
    },
    {
      "s": "",
      "t": "A",
      "n": "Intro2Audio"
    },
    {
      "s": "This the real name of the doctrine that excludes evidence from being submitted in court if it was found due to illegally obtained evidence.",
      "t": "A",
      "v": "723078_1",
      "n": "ExplanationAudio"
    },
    {
      "s": "Remember never accept apples from witches or legal advice from talking furniture. They’re not barristers, they’re bannisters.",
      "t": "A",
      "v": "723079_1",
      "n": "JokeAudio"
    },
    {
      "s": "Suppose in the courtroom finale of <i>Once Upon a Time</i>, Excalibur becomes inadmissible as evidence in Cinderella’s case because it was discovered through an illegally obtained magic mirror. What real world legal doctrine is this?",
      "t": "A",
      "v": "723075_2",
      "n": "QuestionAudio"
    }
