    {
      "t": "S",
      "v": "Say Oscar-nominated director Greta Gerwig made a sequel to Lady Bird.",
      "n": "QuestionText1"
    },
    {
      "s": "Timothée Chalamet Je t'embrasse ",
      "t": "A",
