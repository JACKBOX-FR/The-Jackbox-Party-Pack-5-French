    {
      "t": "S",
      "v": "Si attendre Gal Gadot avait la même conclusion que <i>En attendant Godot</i>, que se passerait-il ? ",
      "n": "QuestionText1"
    },
    {
      "s": "Ma fille, ma copine ",
      "t": "A",
      "v": "714410_1",
      "n": "CategoryAudio"
    },
    {
      "s": "Gal Ga-NO (TOUS) ",
      "t": "A",
      "v": "714422_0",
      "n": "WrongAnswerAudio3"
    },
    {
      "s": "Alors, j'ai revu Wonder Woman l'autre jour et ça m'a fait réfléchir... ",
      "t": "A",
      "v": "714411_1",
      "n": "IntroAudio"
    },
